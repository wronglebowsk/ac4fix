# /etc/default/ac4fix
# Configuration file for ac4fix systemd service

TUNER_URL="http://192.168.1.134:5004"
PORT=5010
BIND_ADDR="0.0.0.0"
FFMPEG_PATH="/usr/lib/jellyfin-ffmpeg/ffmpeg"
AUDIO_CODEC="ac3"
AUDIO_BITRATE="384k"
AUDIO_CHANNELS=6

# Optional: comma-separated manual channel list
# CHANNELS="106.1=WPVI-HD (AC-3):6.1:US19612.hdhomerun.com"
